{
  "title": "PdM-Sentinel: Service health",
  "uid": "pdm-service-health",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["pdm-sentinel"],
  "panels": [
    {
      "id": 1,
      "title": "Request rate by endpoint",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "pdm-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (endpoint) (rate(pdm_requests_total[5m]))",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error rate (% of requests, non-2xx)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "pdm-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100 * sum(rate(pdm_requests_total{status!~\"2..\"}[5m])) / clamp_min(sum(rate(pdm_requests_total[5m])), 1e-9)",
          "legendFormat": "error rate",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Request latency: p50 / p95 / p99",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "pdm-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 0 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(pdm_request_latency_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(pdm_request_latency_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(pdm_request_latency_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        },
        {
          "expr": "0.05",
          "legendFormat": "alert budget (50ms)",
          "refId": "D"
        }
      ]
    },
    {
      "id": 4,
      "title": "Uptime",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "pdm-prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "time() - pdm_process_start_time_seconds",
          "legendFormat": "uptime",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Model version currently loaded",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "pdm-prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "custom": { "textMode": "value_and_name" }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value" },
      "targets": [
        {
          "expr": "pdm_model_info",
          "legendFormat": "{{version}} ({{framework}}, {{bundle_id}})",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "id": 6,
      "title": "Requests by status code",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "pdm-prometheus" },
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "bars", "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(pdm_requests_total[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    }
  ]
}
